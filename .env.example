# Everything works offline with the defaults. Copy to .env and `set -a; source .env; set +a` to override.

# --- LLM backend: mock (default, deterministic, no network) | anthropic | ollama
IO_LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=            # required only when IO_LLM_PROVIDER=anthropic
IO_ANTHROPIC_MODEL=claude-sonnet-5-5
IO_OLLAMA_HOST=http://localhost:11434
IO_OLLAMA_MODEL=llama3.1

# --- persistence & server
# One SQLite file holds both the domain tables (audit, approvals, spans, events ...) and the LangGraph
# checkpoints (tables `checkpoints` / `writes`, thread_id == run id).
IO_DB_PATH=incident_orchestrator.db
# IO_API_TOKEN=                 # if set, every /api route (except /api/health) requires "Authorization: Bearer <token>"

# --- reliability knobs
IO_TASK_TIMEOUT_S=30
IO_TOOL_TIMEOUT_S=5
IO_MAX_TASK_ATTEMPTS=3
IO_AGENT_CONCURRENCY=6
IO_WORKER_CONCURRENCY=4
IO_LEASE_S=30                   # a crashed worker's runs are adopted (and resumed from their checkpoint) after this long

# --- LangGraph tracing hooks (LangSmith). OFF by default: no network calls, whatever the shell exports.
# IO_LANGSMITH=1                # opt in; then set LANGSMITH_API_KEY (and optionally LANGSMITH_PROJECT) as usual

# --- human-in-the-loop
# IO_APPROVAL_TIMEOUT_S=900     # unanswered approvals are auto-REJECTED (fail-safe). Unset = wait forever.

# --- per-run budgets
IO_BUDGET_MAX_STEPS=80
IO_BUDGET_MAX_TOKENS=80000
IO_BUDGET_MAX_COST_USD=0.50
IO_BUDGET_MAX_WALL_CLOCK_S=120
